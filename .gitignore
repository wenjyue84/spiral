# SPIRAL runtime scratch (lives in project root)
.spiral/

# Python
*.pyc
__pycache__/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Test reports (generated by CI bats JUnit output)
test-reports/

# Coverage reports (generated locally and in CI)
coverage_html/
htmlcov/
coverage.xml

# Benchmark results (generated by pytest-benchmark)
.benchmarks/

# Profiling flamegraphs (generated by py-spy, open in https://www.speedscope.app/)
*.svg

# API documentation (generated by pdoc during release)
docs/api/
