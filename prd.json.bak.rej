+    {
+      "id": "US-382",
+      "title": "Extract repeated spiral CI steps into composite actions in .github/actions/",
+      "priority": "low",
+      "description": "SPIRAL's CI has multiple workflow files that repeat setup steps: checkout, uv setup, Python version matrix, shellcheck, shfmt. Converting these into composite actions stored in .github/actions/ reduces duplication, makes SHA-pinned action updates apply in one place, and follows the GitHub Actions 2025 best practice of separating shared task templates from pipeline templates.",
+      "acceptanceCriteria": [
+        "A .github/actions/setup-uv/action.yml composite action handles Python setup, uv install, and cache restore",
+        "A .github/actions/lint-shell/action.yml composite action encapsulates shellcheck and shfmt steps",
