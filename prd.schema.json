{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prd.schema.json",
  "title": "SPIRAL PRD",
  "description": "Schema for SPIRAL Product Requirements Document (prd.json)",
  "type": "object",
  "required": [
    "productName",
    "branchName",
    "userStories"
  ],
  "properties": {
    "productName": {
      "type": "string",
      "minLength": 1
    },
    "branchName": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "PRD schema version for migration support (current: 1)"
    },
    "userStories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/userStory"
      }
    },
    "prd": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional array of file paths to sub-project PRD files to include and merge"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "userStory": {
      "type": "object",
      "required": [
        "id",
        "title",
        "priority",
        "acceptanceCriteria",
        "passes",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(US|UT|FE|BE)-[0-9]{3,}$",
          "description": "Story identifier matching US-NNN, UT-NNN, FE-NNN, or BE-NNN (3 or more digits)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in-progress",
            "done",
            "blocked",
            "blocked-by-sast",
            "skipped"
          ],
          "description": "Optional story lifecycle status"
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "priorityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional numeric priority (0-100, higher = more important). Overrides text priority for sorting when set."
        },
        "description": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "passes": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimatedComplexity": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "model": {
          "type": "string",
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ],
          "description": "Preferred model for implementing this story (assigned by route_stories.py or set manually)"
        },
        "technicalNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_passedCommit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40})?$",
          "description": "40-char hex git SHA or empty string"
        },
        "_decomposed": {
          "type": "boolean"
        },
        "_decomposedFrom": {
          "type": "string"
        },
        "_decomposedInto": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_failureReason": {
          "type": "string"
        },
        "filesTouch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isTestFix": {
          "type": "boolean"
        },
        "epicId": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.:-]+$",
            "minLength": 1
          }
        },
        "_source": {
          "type": "string",
          "enum": [
            "seed",
            "ai-example",
            "research",
            "test-fix",
            "test-story"
          ],
          "description": "Where this story originated"
        },
        "_testType": {
          "type": "string",
          "enum": [
            "integration",
            "e2e",
            "security",
            "performance",
            "regression"
          ],
          "description": "Type of test story (Source 5 only)"
        },
        "_forStoryId": {
          "type": "string",
          "description": "Implementation story ID this test story was generated from (Source 5 only)"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "_skipped": {
          "type": "boolean"
        },
        "added_by": {
          "type": "string"
        },
        "added_ts": {
          "type": "string"
        },
        "_low_confidence_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields flagged as low-confidence by consistency check (US-228)"
        },
        "_consistency_check_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Consistency check confidence percentage (100 - low_confidence_percentage)"
        },
        "_requires_human_review": {
          "type": "boolean",
          "description": "True if >20% of acceptance criteria fields diverged between consistency runs"
        },
        "_human_review_reason": {
          "type": "string",
          "description": "Explanation of why human review is required"
        },
        "_consistency_check_cost": {
          "type": "number",
          "minimum": 0,
          "description": "API cost of running consistency checks (separate from implementation cost)"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 timestamp when the story was marked complete (null if not yet completed)"
        },
        "_antiPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Implementation approaches that previously failed — Ralph must avoid these"
        },
        "_phaseI": {
          "type": "object",
          "description": "Phase I runtime metadata (diagnosis block, attempt notes)",
          "additionalProperties": true
        },
        "_contextStats": {
          "type": "object",
          "description": "Context window usage statistics for the last implementation attempt",
          "additionalProperties": true
        },
        "last_attempted": {
          "type": "string",
          "description": "ISO 8601 timestamp of the most recent implementation attempt"
        },
        "_scopeCreep": {
          "type": "boolean",
          "description": "Flagged by scope-creep guard"
        },
        "_validation_confidence": {
          "type": "number",
          "description": "Confidence score from story validation (0.0-1.0)"
        },
        "_dlq": {
          "type": "boolean",
          "description": "Marks story as permanently failed (moved to Dead Letter Queue after exhausting retries)"
        },
        "_dlqMetadata": {
          "type": "object",
          "description": "DLQ metadata: timestamp, retryCount, reason — written by `main.py dlq promote`",
          "additionalProperties": true
        },
        "verification": {
          "type": "object",
          "description": "Per-story verification contract. When present, Phase V uses this instead of the filesTouch heuristic.",
          "properties": {
            "testFiles": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ],
              "description": "Explicit test file(s) to run (string or array of strings; overrides filesTouch heuristic)"
            },
            "testMarker": {
              "type": "string",
              "description": "pytest marker for story-specific tests (e.g. 'US_1086')"
            },
            "command": {
              "type": "string",
              "description": "Arbitrary verification command (exit 0 = pass)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
