+            textwrap.dedent("""\
+                #!/bin/bash
+                # Parse --output flag to get output path
+                OUTPUT=""
+                while [[ $# -gt 0 ]]; do
+                    case $1 in
+                        --output) OUTPUT="$2"; shift 2 ;;
+                        *) shift ;;
+                    esac
+                done
+                cat > "$OUTPUT" <<'CHANGELOG'
+                # Changelog
