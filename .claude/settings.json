          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "python \"C:/Users/Jyue/Documents/1-projects/Software Projects/Spiral/.claude/hooks/verify_story_acceptance.py\""
          }
        ]
      }
    ]
  }
}
