{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat ralph/CONTEXT_REFRESH.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
