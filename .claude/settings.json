{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "command": "cat ralph/CONTEXT_REFRESH.md"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/protect-spiral-files.sh"
      }
    ],
    "WorktreeCreate": [
      {
        "command": "bash .claude/hooks/worktree_audit.sh"
      }
    ],
    "WorktreeRemove": [
      {
        "command": "bash .claude/hooks/worktree_audit.sh"
      }
    ]
  }
}
