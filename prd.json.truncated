  "userStories": [
    {
      "id": "US-218",
      "title": "Detect and reset dirty worker worktrees at startup to recover from abrupt session termination",
      "description": "When Claude Code sessions stop abruptly (OOM kill, user interrupt, network drop), worker worktrees are left with staged/unstaged changes and reported as dirty submodules. On spiral.sh startup (before launching workers), detect each worker worktree with non-empty git status --porcelain output. For each dirty worktree, run git reset HEAD followed by git checkout -- . to restore a clean state. Emit a worker_reset_dirty_worktree event to spiral_events.jsonl listing which worktrees were cleaned. This ensures the next spiral run starts from a consistent state without manual intervention.",
      "priority": "high",
      "passes": true,
      "retryCount": 0,
      "filesTouch": [
        "spiral.sh",
        "lib/run_parallel_ralph.sh"
      ],
      "acceptanceCriteria": [
        "Implemented as described in the story description."
      ],
      "dependencies": [],
      "tags": [
        "module-lib"
      ]
    },
    {
